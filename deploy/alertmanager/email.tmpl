{{/* Mẫu email cảnh báo TBT Center: nền sáng, dải vàng, bảng chi tiết */}}

{{ define "tbt.subject" -}}
[{{ if eq .Status "firing" }}CẢNH BÁO{{ else }}ĐÃ HỒI PHỤC{{ end }}] {{ .CommonLabels.alertname }}
{{- with .CommonLabels.region }} · khu vực {{ . }}{{ end }} ({{ len .Alerts }})
{{- end }}

{{ define "tbt.html" -}}
<!DOCTYPE html>
<html lang="vi">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width"></head>
<body style="margin:0;padding:0;background:#f2f1ee;font-family:Segoe UI,Roboto,Arial,sans-serif;color:#1d1b18">
<table width="100%" cellpadding="0" cellspacing="0" style="background:#f2f1ee;padding:24px 0">
<tr><td align="center">
<table width="640" cellpadding="0" cellspacing="0" style="max-width:640px;background:#ffffff;border-radius:14px;overflow:hidden;border:1px solid #e4e1da">

  <tr><td style="background:#0b0b0d;padding:22px 28px">
    <div style="font-size:22px;font-weight:800;letter-spacing:6px;color:#d4af37">TBT&nbsp;CENTER</div>
    <div style="font-size:11px;letter-spacing:3px;color:#a8a29e;margin-top:2px">MONITORING · PROMETHEUS</div>
  </td></tr>

  <tr><td style="padding:22px 28px 6px">
    {{ if eq .Status "firing" }}
    <span style="display:inline-block;background:#fdecee;color:#b3261e;border:1px solid #f4b7bd;border-radius:999px;padding:5px 14px;font-weight:700;font-size:13px">● ĐANG LỖI</span>
    {{ else }}
    <span style="display:inline-block;background:#e8f6ee;color:#1b6b47;border:1px solid #b5e2c8;border-radius:999px;padding:5px 14px;font-weight:700;font-size:13px">● ĐÃ HỒI PHỤC</span>
    {{ end }}
    <h1 style="font-size:22px;margin:14px 0 4px;font-weight:800">{{ .CommonLabels.alertname }}</h1>
    <div style="color:#6b665f;font-size:14px">
      {{ len .Alerts }} cảnh báo{{ with .CommonLabels.region }} · khu vực <b>{{ . }}</b>{{ end }}{{ with .CommonLabels.severity }} · mức <b>{{ . }}</b>{{ end }}
    </div>
  </td></tr>

  <tr><td style="padding:14px 28px 8px">
    {{ range .Alerts }}
    <table width="100%" cellpadding="0" cellspacing="0" style="border:1px solid #ece9e3;border-left:5px solid {{ if eq .Status "firing" }}#d93a3a{{ else }}#2e9e6a{{ end }};border-radius:10px;margin-bottom:12px">
      <tr><td style="padding:14px 16px">
        <div style="font-size:15px;font-weight:700;margin-bottom:6px">{{ .Annotations.summary }}</div>
        <table cellpadding="0" cellspacing="0" style="font-size:13px;color:#4a4640">
          {{ with .Labels.instance }}<tr><td style="padding:2px 14px 2px 0;color:#8a847b">Service</td><td><code>{{ . }}</code></td></tr>{{ end }}
          {{ with .Labels.region }}<tr><td style="padding:2px 14px 2px 0;color:#8a847b">Khu vực</td><td>{{ . }}</td></tr>{{ end }}
          <tr><td style="padding:2px 14px 2px 0;color:#8a847b">Bắt đầu</td><td>{{ .StartsAt.Format "02/01/2006 15:04:05 MST" }}</td></tr>
          {{ if eq .Status "resolved" }}<tr><td style="padding:2px 14px 2px 0;color:#8a847b">Hồi phục</td><td>{{ .EndsAt.Format "02/01/2006 15:04:05 MST" }}</td></tr>{{ end }}
        </table>
      </td></tr>
    </table>
    {{ end }}
  </td></tr>

  <tr><td style="padding:4px 28px 24px">
    <a href="http://localhost:9099/alerts" style="display:inline-block;background:#d4af37;color:#0b0b0d;text-decoration:none;font-weight:700;padding:10px 18px;border-radius:999px;font-size:14px">Mở Prometheus</a>
    &nbsp;
    <a href="http://localhost:3000" style="display:inline-block;border:1px solid #d4af37;color:#8a6e1f;text-decoration:none;font-weight:700;padding:9px 18px;border-radius:999px;font-size:14px">Mở Grafana</a>
  </td></tr>

  <tr><td style="background:#faf9f6;border-top:1px solid #ece9e3;padding:14px 28px;font-size:12px;color:#8a847b">
    Email tự động từ Alertmanager của hệ thống TBT Center (Nhóm 16). Docker và autoheal tự khởi động lại container hỏng; email này để biết sự cố đã xảy ra.
  </td></tr>

</table>
</td></tr>
</table>
</body>
</html>
{{- end }}
