# Mỗi công ty (khu vực) một kênh chi riêng: chép thành payos-<khu vực>.env (vd payos-vn.env)
# rồi điền khóa kênh Chi của payOS (my.payos.vn)
PAYOS_ENABLED=false
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
# Số tiền chi thật mỗi khoản (VND), CSDL vẫn ghi số lương đầy đủ
PAYOS_PAYOUT_AMOUNT=2000
# Tài khoản nhận: BIN theo danh sách VietQR (MoMo 971025) và số tài khoản
PAYOS_TO_BIN=971025
PAYOS_TO_ACCOUNT=
